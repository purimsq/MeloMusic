{
  "name": "muse-desktop",
  "version": "1.0.0",
  "description": "MUSE PC — High-Fidelity Desktop Music & Visuals",
  "author": "MUSE Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/purimsq/MeloMusic.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on tcp:5174 && electron .\"",
    "dev:vite": "vite --port 5174 --host",
    "dev:electron": "electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win --x64",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.purimsq.melomusic",
    "productName": "MUSE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MUSE",
      "deleteAppDataOnUninstall": true,
      "include": "electron/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "purimsq",
      "repo": "MeloMusic"
    }
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "vite": "^6.0.0",
    "wait-on": "^9.5.1"
  }
}
